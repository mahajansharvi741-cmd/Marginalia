# Copy this file to `secrets.toml` for local use (it is git-ignored).
# On Streamlit Community Cloud, paste the same contents into
# App -> Settings -> Secrets instead.

GEMINI_API_KEY = "your-gemini-key"
APP_PASSWORD = "choose-any-password"

# Optional: Google login (see README). Delete this block to use the password gate.
# [auth]
# redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
# cookie_secret = "any-random-long-string"
#
# [auth.google]
# client_id = "your-client-id"
# client_secret = "your-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
